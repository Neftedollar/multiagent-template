<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>multiagent-setup</ToolCommandName>
    <PackageId>multiagent-setup</PackageId>
    <Version>1.9.0</Version>
    <Description>Scaffold a multi-agent AI workspace (Claude Code, Nessy CLI, Codex, Qwen)</Description>
    <Authors>Roman Melnikov</Authors>
    <PackageTags>claude;ai;multiagent;workspace;nessy</PackageTags>
    <AssemblyName>MultiagentSetup</AssemblyName>
    <RootNamespace>MultiagentSetup</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Root docs -->
    <EmbeddedResource Include="Templates/CLAUDE.md" LogicalName="CLAUDE.md" />

    <!-- Docs -->
    <EmbeddedResource Include="Templates/docs/process.md" LogicalName="docs/process.md" />
    <EmbeddedResource Include="Templates/docs/role-capabilities.md" LogicalName="docs/role-capabilities.md" />

    <!-- Workflows -->
    <EmbeddedResource Include="Templates/docs/workflows/REGISTRY.md" LogicalName="docs/workflows/REGISTRY.md" />
    <EmbeddedResource Include="Templates/docs/workflows/WORKFLOW-feature-pipeline.md" LogicalName="docs/workflows/WORKFLOW-feature-pipeline.md" />
    <EmbeddedResource Include="Templates/docs/workflows/WORKFLOW-bugfix-pipeline.md" LogicalName="docs/workflows/WORKFLOW-bugfix-pipeline.md" />
    <EmbeddedResource Include="Templates/docs/workflows/WORKFLOW-infra-pipeline.md" LogicalName="docs/workflows/WORKFLOW-infra-pipeline.md" />
    <EmbeddedResource Include="Templates/docs/workflows/WORKFLOW-content-pipeline.md" LogicalName="docs/workflows/WORKFLOW-content-pipeline.md" />
    <EmbeddedResource Include="Templates/docs/workflows/WORKFLOW-spike-pipeline.md" LogicalName="docs/workflows/WORKFLOW-spike-pipeline.md" />
    <EmbeddedResource Include="Templates/docs/workflows/WORKFLOW-autonomous-orchestration.md" LogicalName="docs/workflows/WORKFLOW-autonomous-orchestration.md" />

    <!-- Claude commands + config -->
    <EmbeddedResource Include="Templates/.claude/commands/orchestrator.md" LogicalName=".claude/commands/orchestrator.md" />
    <EmbeddedResource Include="Templates/.claude/mcp.json" LogicalName=".claude/mcp.json" />
    <EmbeddedResource Include="Templates/.claude/settings.json" LogicalName=".claude/settings.json" />

    <!-- Hooks -->
    <EmbeddedResource Include="Templates/.claude/hooks/lint.json" LogicalName=".claude/hooks/lint.json" />

    <!-- Provider: Codex -->
    <EmbeddedResource Include="Templates/providers/codex/.codex/config.toml" LogicalName="providers/codex/.codex/config.toml" />
    <EmbeddedResource Include="Templates/providers/codex/.codex/hooks.json" LogicalName="providers/codex/.codex/hooks.json" />
    <EmbeddedResource Include="Templates/providers/codex/.codex/skills/orchestrator.md" LogicalName="providers/codex/.codex/skills/orchestrator.md" />

    <!-- Provider: Qwen -->
    <EmbeddedResource Include="Templates/providers/qwen/.qwen/settings.json" LogicalName="providers/qwen/.qwen/settings.json" />

    <!-- Tool scripts -->
    <EmbeddedResource Include="Templates/tools/sync-roles.sh" LogicalName="tools/sync-roles.sh" />
    <EmbeddedResource Include="Templates/tools/sync-roles.ps1" LogicalName="tools/sync-roles.ps1" />
    <EmbeddedResource Include="Templates/tools/install-mcps.sh" LogicalName="tools/install-mcps.sh" />
    <EmbeddedResource Include="Templates/tools/install-mcps.ps1" LogicalName="tools/install-mcps.ps1" />
    <EmbeddedResource Include="Templates/tools/completions.zsh" LogicalName="tools/completions.zsh" />
    <EmbeddedResource Include="Templates/tools/completions.ps1" LogicalName="tools/completions.ps1" />
  </ItemGroup>
</Project>
