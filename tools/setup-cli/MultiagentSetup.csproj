<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>multiagent-setup</ToolCommandName>
    <PackageId>multiagent-setup</PackageId>
    <Version>1.2.0</Version>
    <Description>Scaffold a multi-agent Claude Code workspace from template</Description>
    <Authors>Roman Melnikov</Authors>
    <PackageTags>claude;ai;multiagent;workspace</PackageTags>
    <AssemblyName>MultiagentSetup</AssemblyName>
    <RootNamespace>MultiagentSetup</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Root docs -->
    <EmbeddedResource Include="../../CLAUDE.md" LogicalName="CLAUDE.md">
      <Link>Templates/CLAUDE.md</Link>
    </EmbeddedResource>

