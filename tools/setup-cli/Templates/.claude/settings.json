{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_EXEC}} hook block-dangerous"
          },
          {
            "type": "command",
            "command": "{{HOOK_EXEC}} hook enforce-commit-msg"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_EXEC}} hook log-agent"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_EXEC}} hook auto-lint"
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_EXEC}} hook research-reminder"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_EXEC}} hook stop-guard"
          }
        ]
      }
    ]
  }
}
